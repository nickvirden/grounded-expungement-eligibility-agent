# Keep the Docker build context lean when building from the monorepo root.
# Only files needed for apps/web and apps/api builds are included.

# Version control
.git
.gitignore

# Local env / secrets
.env
.env.local
.env.*.local

# Node
node_modules
**/node_modules
**/.pnpm-store

# Python
**/__pycache__
**/.venv
**/*.pyc
apps/api/data/

# Next.js
apps/web/.next
apps/web/out

# Test artefacts
e2e/test-results
e2e/playwright-report
**/.pytest_cache
**/coverage

# Docs / misc
*.md
LICENSE
PLAN.md
DECISIONS.md
CHALLENGE.md
scripts/
caddy/

# Editor
.cursor
.idea
.vscode
