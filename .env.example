# LLM Provider -- only testmodel is usable today. openai, anthropic, and
# ollama are all rejected at startup: their construction is a known,
# currently-broken bug, not just unconfigured credentials. Leave blank or
# unset for the default (testmodel).
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Application
# The API's CORS/CSRF-origin allowlist. Only takes effect for Docker
# Compose, which loads this file via env_file -- and even there,
# docker-compose.yml's own `environment:` block overrides it to
# https://localhost (Caddy's TLS-terminated origin, no port). Running the
# API without Docker reads a .env in the current directory (apps/api/, per
# README's "without Docker" flow), not this root-level file -- set
# ALLOWED_ORIGINS there directly if that flow needs a non-default value.
ALLOWED_ORIGINS=http://localhost:3000

# Next.js (private — server components + Route Handlers only). The browser
# never talks to the API directly; it goes through the same-origin
# /api/backend proxy, which forwards using this.
INTERNAL_API_URL=http://api:8000

# Security
SESSION_SECRET=
CSRF_SECRET=
SSE_SIGNING_KEY=

# Database
# Docker Compose runs Postgres and builds the API's DATABASE_URL from
# POSTGRES_PASSWORD (required -- compose refuses to start without it). It is
# embedded in a connection URL, so use URL-safe characters only, e.g. the
# output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Local dev without Docker defaults to SQLite. To run against Postgres
# instead, point this at it (psycopg3 driver) and run `alembic upgrade head`
# from apps/api, e.g.:
#   DATABASE_URL=postgresql+psycopg://eligibility:<password>@localhost:5432/eligibility
DATABASE_URL=sqlite:///./data/eligibility.db

# Observability (optional)
LOGFIRE_TOKEN=
