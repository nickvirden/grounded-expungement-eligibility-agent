# LLM Provider -- only testmodel is usable today. openai, anthropic, and
# ollama are all rejected at startup: their construction is a known,
# currently-broken bug, not just unconfigured credentials. Leave blank or
# unset for the default (testmodel).
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Application
API_URL=http://api:8000
WEB_URL=https://localhost:3000
ALLOWED_ORIGINS=https://localhost:3000

# Next.js (public — sent to browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Next.js (private — server components + Route Handlers only)
INTERNAL_API_URL=http://api:8000

# Security
SESSION_SECRET=
CSRF_SECRET=
SSE_SIGNING_KEY=

# Database
DATABASE_URL=sqlite:///./data/eligibility.db

# Observability (optional)
LOGFIRE_TOKEN=
