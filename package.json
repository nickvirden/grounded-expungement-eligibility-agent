{
  "name": "grounded-expungement-eligibility-agent",
  "version": "2.4.7",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm --filter web typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:styles": "pnpm --filter web check:styles",
    "test": "pnpm --filter web test && pnpm test:scripts",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "e2e": "pnpm --filter e2e test",
    "e2e:prod": "pnpm --filter web build && E2E_WEB_MODE=production pnpm e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  }
}
