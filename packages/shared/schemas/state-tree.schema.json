{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nickvirden/grounded-expungement-eligibility-agent/main/packages/shared/schemas/state-tree.schema.json",
  "title": "State Decision Tree",
  "description": "Schema for extracted eligibility decision trees",
  "type": "object",
  "required": ["state", "version", "entryNodeId", "nodes", "results", "transitions"],
  "properties": {
    "state": {
      "type": "string",
      "description": "US state identifier (lowercase)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "extractedFrom": {
      "type": "string"
    },
    "extractedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entryNodeId": {
      "type": "string",
      "pattern": "^\\d+-\\d+$",
      "description": "Key into `nodes` for the true root question"
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^\\d+-\\d+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Node"
      },
      "minProperties": 1
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Transition"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Node": {
      "type": "object",
      "required": ["group", "variant", "question", "answers", "questionsLeft"],
      "properties": {
        "group": {
          "type": "integer",
          "minimum": 0
        },
        "variant": {
          "type": "integer",
          "minimum": 0
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": ["string", "null"]
        },
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Answer"
          }
        },
        "questionsLeft": {
          "type": ["integer", "null"]
        }
      },
      "additionalProperties": false
    },
    "Answer": {
      "type": "object",
      "required": ["value", "position"],
      "properties": {
        "value": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "object",
          "required": ["questionId", "answerPosition"],
          "properties": {
            "questionId": { "type": "integer", "minimum": 0 },
            "answerPosition": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "to": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "questionId", "nodeId"],
              "properties": {
                "type": { "const": "question" },
                "questionId": { "type": "integer", "minimum": 0 },
                "nodeId": { "type": "string", "pattern": "^\\d+-\\d+$" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "value"],
              "properties": {
                "type": { "const": "result" },
                "value": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
